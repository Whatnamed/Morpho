# Local Cloudflare Worker runtime configuration. Keep the real .dev.vars untracked.
# NEXT_PUBLIC_* values are read by cf:build from .env.local, not from this file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
MORPHO_AUTH_REQUIRED=true

MORPHO_AI_PROVIDER=aijws
MORPHO_AI_BASE_URL=https://api.aijws.com/v1
MORPHO_AI_API_KEY=
MORPHO_AI_MODEL=gpt-5.6-terra
MORPHO_AI_REASONING_EFFORT=high
MORPHO_AI_WEB_SEARCH_ENABLED=true
# Optional server-generated Provider partition hints only; never a security or cache-hit proof.
MORPHO_AI_SUPPORTS_PROMPT_CACHE_KEY=false
MORPHO_AI_SUPPORTS_PROMPT_CACHE_RETENTION=false
MORPHO_AI_PROMPT_CACHE_KEY_ENABLED=false
MORPHO_AI_PROMPT_CACHE_RETENTION=

MORPHO_GRS_API_KEY=
MORPHO_GRS_BASE_URL=https://grsai.dakka.com.cn
MORPHO_GRS_FALLBACK_BASE_URLS=https://grsaiapi.com
MORPHO_GRS_DEFAULT_MODEL=gpt-image-2
MORPHO_GRS_IMAGE_MODEL=

MORPHO_ALLOW_PAID_SMOKE_TESTS=false
