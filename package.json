{
  "name": "morpho",
  "version": "1.0.0",
  "description": "Morpho is an AI-assisted concept-development workspace for product and industrial designers.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build-production.mjs",
    "build:evidence": "node ./scripts/build-production.mjs --strict",
    "cf:build": "node ./scripts/build-cloudflare.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
    "case-study:import": "node ./scripts/import-case-study-backup.mjs",
    "case-study:upgrade": "node ./scripts/upgrade-current-case-study.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "measure:perf": "node ./scripts/measure-performance.mjs",
    "measure:perf:browser": "playwright test --project=perf --workers=1 --retries=0",
    "measure:storage": "node ./scripts/measure-storage-footprint.mjs",
    "start": "node ./scripts/start-production.mjs",
    "start:evidence": "node ./scripts/start-production.mjs --strict",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:build": "npm run build && npm run test:e2e",
    "test:prompt-cache": "node scripts/test-prompt-cache-compatibility.mjs",
    "typecheck": "tsc --noEmit",
    "measure:perf5:browser": "node ./scripts/measure-perf5-browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.21.0",
    "next": "16.3.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "0.0.1",
    "tldraw": "^5.1.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "4.121.0"
  }
}
