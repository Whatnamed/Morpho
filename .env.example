# Public browser configuration. These values must be available when Next.js builds for Vercel or Cloudflare.
# The tldraw key is safe to expose to the browser; do not use a Vercel-only key for a workers.dev deployment.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Supabase Auth for closed-test access. The publishable key is browser-safe; never use a service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
MORPHO_AUTH_REQUIRED=true

# Server-side AI configuration. Copy this file to .env.local for local Next.js development.
# Do not commit real secrets. Cloudflare Worker runtime values belong in .dev.vars locally or Worker settings after deployment.

MORPHO_AI_PROVIDER=aijws
MORPHO_AI_BASE_URL=https://api.aijws.com/v1
MORPHO_AI_API_KEY=
MORPHO_AI_MODEL=gpt-5.6-terra
MORPHO_AI_REASONING_EFFORT=high
MORPHO_AI_WEB_SEARCH_ENABLED=true
# Provider Prompt Cache Hints are opt-in because OpenAI-compatible relays may reject them.
# Morpho derives opaque server-only partition hints from authenticated user/project, model, Prompt Contract,
# Tool Profile, and stable system prefix. They are performance hints, never identity, ownership, or replay proof.
MORPHO_AI_SUPPORTS_PROMPT_CACHE_KEY=false
MORPHO_AI_SUPPORTS_PROMPT_CACHE_RETENTION=false
MORPHO_AI_PROMPT_CACHE_KEY_ENABLED=false
MORPHO_AI_PROMPT_CACHE_RETENTION=

MORPHO_GRS_API_KEY=
MORPHO_GRS_BASE_URL=https://grsai.dakka.com.cn
MORPHO_GRS_FALLBACK_BASE_URLS=https://grsaiapi.com
# Required exact HTTPS hostnames for Provider result images. Current /v1/api/generate contract uses file1.aitohumanize.com.
# Provider base/fallback hosts are allowed automatically; re-verify the Provider contract before changing this list.
MORPHO_GRS_IMAGE_HOST_ALLOWLIST=file1.aitohumanize.com
MORPHO_GRS_DEFAULT_MODEL=gpt-image-2
# Legacy compatibility only. Prefer MORPHO_GRS_DEFAULT_MODEL for new setups.
MORPHO_GRS_IMAGE_MODEL=

MORPHO_ALLOW_PAID_SMOKE_TESTS=false
