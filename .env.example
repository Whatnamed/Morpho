# Morpho server-only AI configuration.
# Copy this file to .env.local for local development. Never commit real secrets.

MORPHO_AI_PROVIDER=mimo
# Recommended: comma-separated key pool. Legacy single-key variables below remain compatible.
MORPHO_MIMO_API_KEYS=
MORPHO_MIMO_API_KEY=
MORPHO_MIMO_API_KEY_2=
MORPHO_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MORPHO_MIMO_TEXT_MODEL=mimo-v2.5-pro
MORPHO_MIMO_MULTIMODAL_MODEL=mimo-v2.5
MORPHO_MIMO_MODEL=
MORPHO_MIMO_WEB_SEARCH_ENABLED=true

MORPHO_GRS_API_KEY=
MORPHO_GRS_BASE_URL=https://grsaiapi.com
MORPHO_GRS_DEFAULT_MODEL=nano-banana-fast
# Legacy compatibility only. Prefer MORPHO_GRS_DEFAULT_MODEL for new setups.
MORPHO_GRS_IMAGE_MODEL=

MORPHO_ALLOW_PAID_SMOKE_TESTS=false
