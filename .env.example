# Public tldraw license key. Required for deployed external testing; this key is safe to expose to the browser.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Supabase Auth for closed-test access. Publishable key is browser-safe; never use service role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
MORPHO_AUTH_REQUIRED=true

# Morpho server-only AI configuration.
# Copy this file to .env.local for local development. Never commit real secrets.

MORPHO_AI_PROVIDER=aijws
MORPHO_AI_BASE_URL=https://api.aijws.com/v1
MORPHO_AI_API_KEY=
MORPHO_AI_MODEL=gpt-5.6-terra
MORPHO_AI_REASONING_EFFORT=high
MORPHO_AI_WEB_SEARCH_ENABLED=true
MORPHO_AI_CONTEXT_WINDOW_TOKENS=372000
MORPHO_AI_CONTEXT_PREPARE_TOKENS=200000
MORPHO_AI_CONTEXT_COMPACT_TOKENS=300000
MORPHO_AI_CONTEXT_TARGET_TOKENS=16000

MORPHO_GRS_API_KEY=
MORPHO_GRS_BASE_URL=https://grsai.dakka.com.cn
MORPHO_GRS_FALLBACK_BASE_URLS=https://grsaiapi.com
MORPHO_GRS_DEFAULT_MODEL=gpt-image-2
# Legacy compatibility only. Prefer MORPHO_GRS_DEFAULT_MODEL for new setups.
MORPHO_GRS_IMAGE_MODEL=

MORPHO_ALLOW_PAID_SMOKE_TESTS=false
